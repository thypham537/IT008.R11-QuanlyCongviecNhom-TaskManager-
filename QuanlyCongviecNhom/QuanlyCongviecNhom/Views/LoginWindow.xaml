<Window x:Class="QuanlyCongviecNhom.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QuanlyCongviecNhom.ViewModels"
        Title="Đăng nhập - Quản lý Công việc Nhóm"
        Height="460" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F6F9">

    <Window.DataContext>
        <vm:LoginViewModel />
    </Window.DataContext>

    <Border Background="White" CornerRadius="12" Margin="24" Padding="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.1" />
        </Border.Effect>

        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="ĐĂNG NHẬP"
                       FontSize="22" FontWeight="Bold"
                       Foreground="#1E293B"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6" />
            <TextBlock Text="Hệ thống Quản lý Công việc Nhóm"
                       FontSize="13" Foreground="#64748B"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24" />

            <!-- Tên đăng nhập / Email -->
            <TextBlock Text="Tên đăng nhập hoặc Email" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6" />
            <TextBox Text="{Binding UsernameOrEmail, UpdateSourceTrigger=PropertyChanged}"
                     Height="38" Padding="10,0" VerticalContentAlignment="Center"
                     FontSize="14" Margin="0,0,0,16" />

            <!-- Mật khẩu -->
            <TextBlock Text="Mật khẩu" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6" />
            <PasswordBox x:Name="PwdBox"
                         Height="38" Padding="10,0" VerticalContentAlignment="Center"
                         FontSize="14" Margin="0,0,0,12" />

            <!-- Thông báo lỗi -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#DC2626" FontSize="12.5"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14" />

            <!-- Nút Đăng nhập -->
            <Button Content="Đăng nhập"
                    Command="{Binding LoginCommand}"
                    CommandParameter="{Binding ElementName=PwdBox}"
                    IsDefault="True"
                    Height="40"
                    Background="#2563EB" Foreground="White"
                    FontSize="14" FontWeight="SemiBold"
                    Cursor="Hand" />

            <!-- Nút chuyển sang Đăng ký -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                <TextBlock Text="Chưa có tài khoản? " Foreground="#64748B" FontSize="13" />
                <TextBlock Text="Đăng ký ngay"
                           Foreground="#2563EB" FontWeight="SemiBold" FontSize="13"
                           Cursor="Hand"
                           MouseLeftButtonUp="OpenRegister_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>