<Window x:Class="QuanlyCongviecNhom.Views.TaskDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Thông tin công việc"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="{StaticResource FontMain}">

    <Window.Resources>
        <!-- Template bo góc chung cho ComboBox -->
        <ControlTemplate x:Key="PillComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <!-- Nền pill phủ toàn bộ ô -->
                <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="10"/>

                <!-- Chữ đang chọn -->
                <ContentPresenter IsHitTestVisible="False"
                          Content="{TemplateBinding SelectionBoxItem}"
                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                          Margin="14,0,34,0"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left"/>

                <!-- Mũi tên sát mép phải -->
                <Path IsHitTestVisible="False"
              Data="M 0 0 L 4.5 4.5 L 9 0"
              Stroke="{TemplateBinding Foreground}"
              StrokeThickness="1.8"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              StrokeLineJoin="Round"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Margin="0,0,14,0"/>

                <!-- Lớp trong suốt để bắt click, bỏ style ngầm định của Material -->
                <ToggleButton Style="{x:Null}"
                      Focusable="False"
                      ClickMode="Press"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <Popup Placement="Bottom"
               IsOpen="{TemplateBinding IsDropDownOpen}"
               AllowsTransparency="True"
               Focusable="False"
               PopupAnimation="Slide">
                    <Border Margin="0,4,0,8"
                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                    Background="{DynamicResource BrushSurfaceCard}"
                    BorderBrush="{DynamicResource BrushBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="4">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#15233C" Opacity="0.1"/>
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 1. Style ComboBox Người phụ trách -->
        <Style x:Key="AssigneeComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource PillComboBoxTemplate}"/>
            <Style.Triggers>
                <Trigger Property="SelectedIndex" Value="0">
                    <Setter Property="Background" Value="{DynamicResource BrushAvatarBlueBg}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushAvatarBlueText}"/>
                </Trigger>
                <Trigger Property="SelectedIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource BrushAvatarPurpleBg}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushAvatarPurpleText}"/>
                </Trigger>
                <Trigger Property="SelectedIndex" Value="2">
                    <Setter Property="Background" Value="{DynamicResource BrushAvatarEmeraldBg}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushAvatarEmeraldText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 2. Style ComboBox Mức độ ưu tiên -->
        <Style x:Key="PriorityComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource PillComboBoxTemplate}"/>
            <Style.Triggers>
                <Trigger Property="SelectedIndex" Value="0">
                    <Setter Property="Background" Value="{DynamicResource BrushPriorityUrgentBg}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushPriorityUrgentText}"/>
                </Trigger>
                <Trigger Property="SelectedIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource BrushPriorityHighBg}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushPriorityHighText}"/>
                </Trigger>
                <Trigger Property="SelectedIndex" Value="2">
                    <Setter Property="Background" Value="{DynamicResource BrushPriorityMediumBg}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushPriorityMediumText}"/>
                </Trigger>
                <Trigger Property="SelectedIndex" Value="3">
                    <Setter Property="Background" Value="{DynamicResource BrushPriorityLowBg}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushPriorityLowText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 3. Style ComboBox Trạng thái -->
        <Style x:Key="FormStatusComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource PillComboBoxTemplate}"/>
            <Style.Triggers>
                <Trigger Property="SelectedIndex" Value="0">
                    <Setter Property="Background" Value="{DynamicResource BrushStatusTodoBg}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushStatusTodoText}"/>
                </Trigger>
                <Trigger Property="SelectedIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource BrushStatusDoingBg}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushStatusDoingText}"/>
                </Trigger>
                <Trigger Property="SelectedIndex" Value="2">
                    <Setter Property="Background" Value="{DynamicResource BrushStatusDoneBg}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushStatusDoneText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Khung Card trắng bo góc 16px + Đổ bóng -->
    <Border Margin="16"
            Background="{DynamicResource BrushSurfaceCard}"
            BorderBrush="{DynamicResource BrushBorderDefault}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="28,24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Color="#15233C" Opacity="0.16"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= HEADER DIALOG ================= -->
            <DockPanel Grid.Row="0" Margin="0,0,0,20" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="BẢNG PHÂN CÔNG" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,4"/>
                    <TextBlock Text="Thông tin công việc" FontSize="{StaticResource FontSizeLG}" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                </StackPanel>

                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="32" Height="32" Padding="0"
                        Background="{DynamicResource BrushAppBackground}"
                        BorderThickness="0" Cursor="Hand"
                        materialDesign:ButtonAssist.CornerRadius="8"
                        Click="BtnCancel_Click">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="{DynamicResource BrushTextSecondary}"/>
                </Button>
            </DockPanel>

            <!-- ================= TÊN CÔNG VIỆC ================= -->
            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <TextBlock Text="TÊN CÔNG VIỆC *" Style="{StaticResource TableHeaderTextStyle}" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtTitle"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Tag="Nhập tên công việc..."/>
            </StackPanel>

            <!-- ================= NGƯỜI PHỤ TRÁCH & ĐỘ ƯU TIÊN ================= -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="NGƯỜI PHỤ TRÁCH" Style="{StaticResource TableHeaderTextStyle}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CboAssignee" Style="{StaticResource AssigneeComboBoxStyle}" SelectedIndex="0">
                        <ComboBoxItem Content="Nguyễn Minh Anh"/>
                        <ComboBoxItem Content="Trần Hoàng Nam"/>
                        <ComboBoxItem Content="Lê Thu Hà"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="MỨC ĐỘ ƯU TIÊN" Style="{StaticResource TableHeaderTextStyle}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CboPriority" Style="{StaticResource PriorityComboBoxStyle}" SelectedIndex="2">
                        <ComboBoxItem Content="Khẩn cấp"/>
                        <ComboBoxItem Content="Cao"/>
                        <ComboBoxItem Content="Trung bình"/>
                        <ComboBoxItem Content="Thấp"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- ================= DEADLINE & TRẠNG THÁI ================= -->
            <Grid Grid.Row="3" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="HẠN CHÓT (DEADLINE)" Style="{StaticResource TableHeaderTextStyle}" Margin="0,0,0,6"/>
                    <Border Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushBorderDefault}" 
                            BorderThickness="1" CornerRadius="10" Height="40" Padding="12,0">
                        <DatePicker x:Name="DpDeadline"
                                    BorderThickness="0" Background="Transparent"
                                    VerticalContentAlignment="Center"
                                    FontSize="{StaticResource FontSizeBody}"
                                    Foreground="{DynamicResource BrushTextPrimary}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="TRẠNG THÁI" Style="{StaticResource TableHeaderTextStyle}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CboStatus" Style="{StaticResource FormStatusComboBoxStyle}" SelectedIndex="0">
                        <ComboBoxItem Content="Cần làm"/>
                        <ComboBoxItem Content="Đang làm"/>
                        <ComboBoxItem Content="Hoàn thành"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- ================= MÔ TẢ CHI TIẾT ================= -->
            <StackPanel Grid.Row="4" Margin="0,0,0,24">
                <TextBlock Text="MÔ TẢ CHI TIẾT" Style="{StaticResource TableHeaderTextStyle}" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtDescription"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Tag="Nhập mô tả hoặc chú thích cho công việc..."
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalContentAlignment="Top"
                         Height="90"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <!-- ================= NÚT HỦY & LƯU ================= -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="96" Margin="0,0,12,0"
                        Click="BtnCancel_Click"/>

                <Button Content="Lưu công việc"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>