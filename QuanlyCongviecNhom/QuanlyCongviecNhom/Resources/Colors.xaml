<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- ==================== 1. NỀN & CHỮ CƠ BẢN (BASE) ==================== -->
    <Color x:Key="ColorAppBackground">#F4F7FB</Color>
    <Color x:Key="ColorSurfaceCard">#FFFFFF</Color>
    <Color x:Key="ColorTextPrimary">#15233C</Color>
    <Color x:Key="ColorTextSecondary">#526278</Color>
    <Color x:Key="ColorTextMuted">#8B9AB0</Color>
    <Color x:Key="ColorBorderDefault">#DCE4EE</Color>
    <Color x:Key="ColorBorderLight">#EDF2F7</Color>
    <SolidColorBrush x:Key="BrushAppBackground" Color="{StaticResource ColorAppBackground}"/>
    <SolidColorBrush x:Key="BrushSurfaceCard" Color="{StaticResource ColorSurfaceCard}"/>
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>
    <SolidColorBrush x:Key="BrushBorderDefault" Color="{StaticResource ColorBorderDefault}"/>
    <SolidColorBrush x:Key="BrushBorderLight" Color="{StaticResource ColorBorderLight}"/>
    
    <!-- ==================== 2. SIDEBAR & BANNER DỰ ÁN (NAVY) ==================== -->
    <Color x:Key="ColorSidebarBg">#103266</Color>
    <Color x:Key="ColorSidebarHover">#1B4482</Color>
    <Color x:Key="ColorBannerBg">#163F7C</Color>
    <Color x:Key="ColorBannerChipBg">#255091</Color>
    <SolidColorBrush x:Key="BrushSidebarBg" Color="{StaticResource ColorSidebarBg}"/>
    <SolidColorBrush x:Key="BrushSidebarHover" Color="{StaticResource ColorSidebarHover}"/>
    <SolidColorBrush x:Key="BrushSidebarText" Color="#D6E4F7"/>
    <SolidColorBrush x:Key="BrushBannerBg" Color="{StaticResource ColorBannerBg}"/>
    <SolidColorBrush x:Key="BrushBannerChipBg" Color="{StaticResource ColorBannerChipBg}"/>
    
    <!-- ==================== 3. NÚT BẤM & Ô NHẬP LIỆU ==================== -->
    <Color x:Key="ColorPrimary">#2F70D0</Color>
    <Color x:Key="ColorPrimaryHover">#245BB0</Color>
    <Color x:Key="ColorInputFocusBorder">#4B82D2</Color>
    <Color x:Key="ColorInputFocusBg">#E4EFFF</Color>
    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}"/>
    <SolidColorBrush x:Key="BrushPrimaryHover" Color="{StaticResource ColorPrimaryHover}"/>
    <SolidColorBrush x:Key="BrushInputFocusBorder" Color="{StaticResource ColorInputFocusBorder}"/>
    <SolidColorBrush x:Key="BrushInputFocusBg" Color="{StaticResource ColorInputFocusBg}"/>
    <SolidColorBrush x:Key="BrushInputBg" Color="#F8FAFD"/>
    <SolidColorBrush x:Key="BrushTabContainerBg" Color="#F0F4FA"/>

    <!-- ==================== 4. TRẠNG THÁI (STATUS) ==================== -->
    <!-- 4.1. Trạng thái Công việc / Task (Dropdown / Badge nền + chữ) -->
    <!-- Cần làm (Todo) - Xám nhạt / Chữ xám đậm -->
    <SolidColorBrush x:Key="BrushStatusTodoBg" Color="#EEF2F6"/>
    <SolidColorBrush x:Key="BrushStatusTodoText" Color="#526278"/>

    <!-- Đang làm (In Progress) - Xanh dương nhạt / Chữ xanh dương đậm -->
    <SolidColorBrush x:Key="BrushStatusDoingBg" Color="#E6F0FF"/>
    <SolidColorBrush x:Key="BrushStatusDoingText" Color="#2861B3"/>

    <!-- Hoàn thành (Done) - Xanh lá nhạt / Chữ xanh lá đậm -->
    <SolidColorBrush x:Key="BrushStatusDoneBg" Color="#E1F5EB"/>
    <SolidColorBrush x:Key="BrushStatusDoneText" Color="#24785B"/>

    <!-- 4.2. Chấm tròn trạng thái của Project (Status Dots) -->
    <SolidColorBrush x:Key="BrushStatusActive" Color="#37A56F"/>
    <!-- Dự án đang hoạt động -->
    <SolidColorBrush x:Key="BrushStatusUpcoming" Color="#3B78D1"/>
    <!-- Dự án sắp tới -->
    <SolidColorBrush x:Key="BrushStatusPaused" Color="#E09B36"/>
    <!-- Dự án tạm dừng -->

    <!-- ==================== 5. MỨC ĐỘ ƯU TIÊN (PRIORITY TAGS) ==================== -->
    <!-- Thấp -->
    <SolidColorBrush x:Key="BrushPriorityLowBg" Color="#EDF5FF"/>
    <SolidColorBrush x:Key="BrushPriorityLowText" Color="#3A70A9"/>
    
    <!-- Trung bình (xuất hiện ở ảnh Bảng công việc & Lịch) -->
    <SolidColorBrush x:Key="BrushPriorityMediumBg" Color="#FEF4DC"/>
    <SolidColorBrush x:Key="BrushPriorityMediumText" Color="#B7791F"/>
    
    <!-- Cao (xuất hiện ở ảnh Bảng công việc & Lịch) -->
    <SolidColorBrush x:Key="BrushPriorityHighBg" Color="#FFEBD9"/>
    <SolidColorBrush x:Key="BrushPriorityHighText" Color="#C05621"/>
    
    <!-- Khẩn cấp -->
    <SolidColorBrush x:Key="BrushPriorityUrgentBg" Color="#FFE4E7"/>
    <SolidColorBrush x:Key="BrushPriorityUrgentText" Color="#B83D50"/>
    
    <!-- ==================== 6. ẢNH ĐẠI DIỆN (AVATARS) ==================== -->
    <SolidColorBrush x:Key="BrushAvatarBlueBg" Color="#DCEAFF"/>
    <SolidColorBrush x:Key="BrushAvatarBlueText" Color="#2861B3"/>
    <SolidColorBrush x:Key="BrushAvatarEmeraldBg" Color="#DFF5EB"/>
    <SolidColorBrush x:Key="BrushAvatarEmeraldText" Color="#24785B"/>
    <SolidColorBrush x:Key="BrushAvatarPurpleBg" Color="#EDE7FF"/>
    <SolidColorBrush x:Key="BrushAvatarPurpleText" Color="#6B46C1"/>
    <SolidColorBrush x:Key="BrushAvatarPinkBg" Color="#FFE4E7"/>
    <SolidColorBrush x:Key="BrushAvatarPinkText" Color="#B83D50"/>
</ResourceDictionary>